{
  "name": "drdice-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for the DRDice declaration-only packages",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "typecheck:ts7": "pnpm exec tsc --project tsconfig.json --pretty false",
    "typecheck:ts6": "pnpm exec tsc6 --project tsconfig.json --pretty false",
    "generate:fixtures": "node verification/generate-fixtures.mjs && node verification/issue-21/generate.mjs && node verification/issue-22/generate.mjs",
    "generate:issue21": "node verification/issue-21/generate.mjs",
    "generate:issue22": "node verification/issue-22/generate.mjs",
    "check:fixtures": "node verification/issue-23/check-fixtures.mjs",
    "check:dice": "node verification/issue-20/check.mjs && node verification/issue-21/check.mjs && node verification/issue-22/check.mjs",
    "check:dice:budget": "node verification/issue-21/check-budget.mjs && node verification/issue-22/check-budget.mjs",
    "check:prng": "node verification/issue-17/check.mjs && node verification/issue-17/check-boundary.mjs && node verification/issue-18/check.mjs && node verification/issue-19/check.mjs",
    "check:prng:budget": "node verification/issue-18/check-budget.mjs --reference-runner && node verification/issue-19/check-budget.mjs --reference-runner",
    "check:clean-consumers": "node verification/check-clean-consumers.mjs",
    "check:packed": "node verification/check-packed-artifacts.mjs",
    "check:parity": "node verification/issue-23/check.mjs",
    "check:budgets": "node verification/check-budgets.mjs --policy all",
    "check:budgets:one-checker": "node verification/check-budgets.mjs --policy one-checker",
    "check:budgets:four-checker": "node verification/check-budgets.mjs --policy four-checker",
    "release:measure": "node verification/issue-24/release.mjs --measure",
    "check:release": "node verification/issue-24/check.mjs",
    "verify": "pnpm typecheck && pnpm check:parity && pnpm check:budgets",
    "verify:ts6": "pnpm typecheck:ts6"
  },
  "devDependencies": {
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2",
    "@drdice/dice": "workspace:*",
    "@drdice/prng": "workspace:*"
  }
}
