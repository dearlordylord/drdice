{
  "name": "drdice-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for the DRDice typed runtime packages",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-packages.mjs",
    "prepare": "pnpm build",
    "check:build": "node scripts/check-package-build.mjs",
    "typecheck": "pnpm build && tsc --project tsconfig.json --pretty false",
    "typecheck:ts7": "pnpm exec tsc --project tsconfig.json --pretty false",
    "typecheck:ts6": "pnpm exec tsc6 --project tsconfig.json --pretty false",
    "generate:fixtures": "node verification/generate-fixtures.mjs && node verification/dice-arithmetic-parity/generate.mjs && node verification/dice-evaluation-parity/generate.mjs && node verification/property-parity/generate.mjs",
    "generate:property-parity": "node verification/property-parity/generate.mjs",
    "generate:dice-arithmetic": "node verification/dice-arithmetic-parity/generate.mjs",
    "generate:dice-evaluation": "node verification/dice-evaluation-parity/generate.mjs",
    "check:fixtures": "node verification/parity/check-fixtures.mjs",
    "check:dice": "node verification/dice-semantics/check.mjs && node verification/dice-arithmetic-parity/check.mjs && node verification/dice-evaluation-parity/check.mjs",
    "check:dice:budget": "node verification/dice-arithmetic-parity/check-budget.mjs && node verification/dice-evaluation-parity/check-budget.mjs",
    "check:prng": "node verification/prng-semantics/check.mjs && node verification/prng-semantics/check-boundary.mjs && node verification/prng-type-parity/check.mjs && node verification/prng-sampling-coverage/check.mjs",
    "check:prng:budget": "node verification/prng-type-parity/check-budget.mjs --reference-runner && node verification/prng-sampling-coverage/check-budget.mjs --reference-runner",
    "check:clean-consumers": "node verification/check-clean-consumers.mjs",
    "check:packed": "node verification/check-packed-artifacts.mjs",
    "check:parity": "node verification/parity/check.mjs",
    "check:usability": "node verification/usability/check.mjs",
    "check:runtime": "node verification/runtime/check.mjs",
    "check:property-parity": "node verification/property-parity/check.mjs",
    "check:property-parity:budget": "node verification/property-parity/check.mjs --reference-runner",
    "check:architecture": "node verification/architecture/check.mjs && node verification/architecture/check-release-tag.mjs && node verification/release/check-policy.mjs",
    "check:budgets": "node verification/check-budgets.mjs --policy all",
    "check:budgets:one-checker": "node verification/check-budgets.mjs --policy one-checker",
    "check:budgets:four-checker": "node verification/check-budgets.mjs --policy four-checker",
    "release:measure": "node verification/release/release.mjs --measure",
    "version:set": "node scripts/set-version.mjs",
    "local-release": "bash scripts/local_release.sh",
    "check:release": "node verification/release/check.mjs",
    "verify": "pnpm typecheck && pnpm check:build && pnpm check:parity && pnpm check:usability && pnpm check:runtime && pnpm check:architecture && pnpm check:budgets",
    "verify:ts6": "pnpm typecheck:ts6"
  },
  "devDependencies": {
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2",
    "@drdice/dice": "workspace:*",
    "@drdice/prng": "workspace:*"
  }
}
