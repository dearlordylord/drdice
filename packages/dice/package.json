{
  "name": "@drdice/dice",
  "version": "0.4.0",
  "description": "Literal-computing dice expressions and runtime grouped sampling for TypeScript",
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs dice",
    "prepack": "pnpm run build"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/groups.d.ts",
    "dist/groups.js",
    "dist/types.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dearlordylord/drdice.git",
    "directory": "packages/dice"
  },
  "dependencies": {
    "@drdice/prng": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
