{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "stripInternal": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": false,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
