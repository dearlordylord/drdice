{
  "name": "@drdice/prng",
  "version": "0.3.4",
  "description": "Literal-computing seeded pseudorandom generation for TypeScript",
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs prng",
    "prepack": "pnpm run build"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/types.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dearlordylord/drdice.git",
    "directory": "packages/prng"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
