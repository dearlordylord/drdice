{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": ["ES2020", "DOM"],
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "packages/*/dist/**/*.d.ts",
    "verification/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "verification/generated/**/*.d.ts"
  ]
}
